@using System.Globalization
@using AnimeCalculator.Core.Skins

@* An original chibi-style mascot, drawn entirely in SVG so every skin can recolour her. *@
<svg class="mascot mood-@Mood.ToString().ToLowerInvariant() @(Small ? "mascot-small" : "")"
     viewBox="0 0 200 220" role="img" aria-label="@($"{Skin.CharacterName}, looking {Mood.ToString().ToLowerInvariant()}")">
    <defs>
        <radialGradient id="@Id("cheek")">
            <stop offset="0%" stop-color="#ff7aa2" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#ff7aa2" stop-opacity="0" />
        </radialGradient>
        <filter id="@Id("glow")" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="3" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
    </defs>

    @* ---------- Behind the head ---------- *@
    @if (L.Accessory == Accessory.Halo)
    {
        <ellipse cx="100" cy="22" rx="38" ry="9" fill="none" stroke="@L.AccessoryColor" stroke-width="5" filter="url(#@Id("glow"))" />
    }

    @switch (L.Hair)
    {
        case HairStyle.Long:
            <path d="M42,100 C36,36 164,36 158,100 L168,206 C140,216 60,216 32,206 Z" fill="@L.HairShade" />
            break;
        case HairStyle.Bob:
            <path d="M40,104 C34,38 166,38 160,104 L164,152 C146,164 54,164 36,152 Z" fill="@L.HairShade" />
            break;
        case HairStyle.Twintails:
            <path d="M40,104 C34,38 166,38 160,104 L162,140 C146,150 54,150 38,140 Z" fill="@L.HairShade" />
            <ellipse cx="28" cy="138" rx="18" ry="58" transform="rotate(10 28 138)" fill="@L.HairColor" />
            <ellipse cx="172" cy="138" rx="18" ry="58" transform="rotate(-10 172 138)" fill="@L.HairColor" />
            <path d="M24,96 Q28,150 22,190" stroke="@L.HairShade" stroke-width="3" fill="none" opacity="0.6" />
            <path d="M176,96 Q172,150 178,190" stroke="@L.HairShade" stroke-width="3" fill="none" opacity="0.6" />
            <circle cx="40" cy="80" r="7" fill="@L.OutfitAccent" />
            <circle cx="160" cy="80" r="7" fill="@L.OutfitAccent" />
            break;
        case HairStyle.Ponytail:
            <ellipse cx="164" cy="118" rx="20" ry="62" transform="rotate(18 164 118)" fill="@L.HairShade" />
            <path d="M40,104 C34,38 166,38 160,104 L162,146 C146,156 54,156 38,146 Z" fill="@L.HairShade" />
            <circle cx="150" cy="58" r="7" fill="@L.OutfitAccent" />
            break;
    }

    @if (L.Accessory is Accessory.CatEars or Accessory.FoxEars)
    {
        var tip = L.Accessory == Accessory.FoxEars ? 12 : 24;
        var inner = L.Accessory == Accessory.FoxEars ? "#fff3e0" : "#ffb3c7";
        <path d="@($"M50,74 L{(L.Accessory == Accessory.FoxEars ? 46 : 56)},{tip} L90,48 Z")" fill="@L.AccessoryColor" />
        <path d="@($"M150,74 L{(L.Accessory == Accessory.FoxEars ? 154 : 144)},{tip} L110,48 Z")" fill="@L.AccessoryColor" />
        <path d="@($"M58,66 L{(L.Accessory == Accessory.FoxEars ? 54 : 60)},{tip + 14} L82,50 Z")" fill="@inner" />
        <path d="@($"M142,66 L{(L.Accessory == Accessory.FoxEars ? 146 : 140)},{tip + 14} L118,50 Z")" fill="@inner" />
    }

    @* ---------- Body ---------- *@
    <rect x="88" y="148" width="24" height="22" fill="@L.SkinTone" />
    <path d="M44,220 C48,182 70,166 100,166 C130,166 152,182 156,220 Z" fill="@L.OutfitColor" />
    <path d="M78,168 L100,194 L122,168 Z" fill="@L.OutfitAccent" />
    <path d="M100,192 L88,184 L88,200 Z M100,192 L112,184 L112,200 Z" fill="@L.OutfitAccent" stroke="#00000022" />
    <circle cx="100" cy="192" r="3.5" fill="@L.OutfitColor" />

    @* ---------- Face ---------- *@
    <ellipse cx="100" cy="108" rx="50" ry="52" fill="@L.SkinTone" />

    @* Eyes *@
    @foreach (var x in new[] { 80, 120 })
    {
        const int y = 118;
        switch (Mood)
        {
            case Mood.Happy:
                <path d="@($"M{x - 11},{y + 3} Q{x},{y - 11} {x + 11},{y + 3}")" stroke="#3a1f2b" stroke-width="3.5" fill="none" stroke-linecap="round" />
                break;
            case Mood.Love:
                <path d="@($"M{x},{y + 9} C{x - 16},{y - 2} {x - 9},{y - 15} {x},{y - 6} C{x + 9},{y - 15} {x + 16},{y - 2} {x},{y + 9} Z")" fill="#ff3b7f" />
                <circle cx="@(x - 4)" cy="@(y - 5)" r="2" fill="#fff" />
                break;
            case Mood.Shocked:
                <circle cx="@x" cy="@y" r="12" fill="#fff" stroke="#3a1f2b" stroke-width="2" />
                <circle cx="@x" cy="@y" r="4" fill="@L.EyeColor" />
                <circle cx="@(x + 1)" cy="@(y - 1)" r="1.4" fill="#fff" />
                break;
            default:
                var dx = Mood == Mood.Thinking ? -2 : 0;
                var dy = Mood == Mood.Thinking ? -3 : 0;
                <ellipse cx="@x" cy="@y" rx="11" ry="13" fill="#fff" />
                <ellipse cx="@(x + dx)" cy="@(y + 1 + dy)" rx="9" ry="11" fill="@L.EyeColor" />
                <ellipse cx="@(x + dx)" cy="@(y + 3 + dy)" rx="4.5" ry="5.5" fill="#1b0f14" />
                <circle cx="@(x + 3 + dx)" cy="@(y - 4 + dy)" r="3.2" fill="#fff" />
                <circle cx="@(x - 3 + dx)" cy="@(y + 5 + dy)" r="1.5" fill="#fff" opacity="0.85" />
                @if (Mood == Mood.Smug)
                {
                    <rect x="@(x - 13)" y="@(y - 16)" width="26" height="12" fill="@L.SkinTone" />
                    <path d="@($"M{x - 12},{y - 4} L{x + 12},{y - 5}")" stroke="#3a1f2b" stroke-width="3.5" stroke-linecap="round" />
                }
                else
                {
                    <path d="@($"M{x - 12},{y - 9} Q{x},{y - 17} {x + 12},{y - 9}")" stroke="#3a1f2b" stroke-width="3.5" fill="none" stroke-linecap="round" />
                }
                break;
        }
    }

    @* Blush *@
    <ellipse cx="68" cy="136" rx="11" ry="6" fill="url(#@Id("cheek"))" opacity="@(Mood is Mood.Love or Mood.Happy ? "0.9" : "0.55")" />
    <ellipse cx="132" cy="136" rx="11" ry="6" fill="url(#@Id("cheek"))" opacity="@(Mood is Mood.Love or Mood.Happy ? "0.9" : "0.55")" />

    @* Mouth *@
    @switch (Mood)
    {
        case Mood.Happy:
            <path d="M89,137 Q100,154 111,137 Z" fill="#a8324a" />
            <path d="M95,145 Q100,150 105,145 Q100,143 95,145 Z" fill="#ff8fab" />
            break;
        case Mood.Shocked:
            <ellipse cx="100" cy="144" rx="5" ry="7" fill="#a8324a" />
            break;
        case Mood.Love:
            <path d="M91,139 Q95.5,145 100,139 Q104.5,145 109,139" stroke="#7a2b3a" stroke-width="2.5" fill="none" stroke-linecap="round" />
            break;
        case Mood.Thinking:
            <path d="M95,143 L105,141" stroke="#7a2b3a" stroke-width="2.5" stroke-linecap="round" />
            break;
        case Mood.Smug:
            <path d="M92,141 Q102,146 109,136" stroke="#7a2b3a" stroke-width="2.5" fill="none" stroke-linecap="round" />
            break;
        default:
            <path d="M94,140 Q100,147 106,140" stroke="#7a2b3a" stroke-width="2.5" fill="none" stroke-linecap="round" />
            break;
    }

    @* ---------- Front hair ---------- *@
    <path d="M48,112 C40,56 72,38 100,38 C128,38 160,56 152,112 L146,92 L136,110 L128,80 L114,102 L100,72 L86,102 L72,80 L64,110 L54,92 Z" fill="@L.HairColor" />
    <path d="M50,98 C42,128 44,152 52,168 L62,118 Z" fill="@L.HairColor" />
    <path d="M150,98 C158,128 156,152 148,168 L138,118 Z" fill="@L.HairColor" />
    <path d="M70,58 Q100,44 130,58" stroke="#ffffff" stroke-width="4" fill="none" opacity="0.45" stroke-linecap="round" />
    <path d="M100,40 Q92,22 104,14" stroke="@L.HairColor" stroke-width="5" fill="none" stroke-linecap="round" />

    @* ---------- Accessories ---------- *@
    @switch (L.Accessory)
    {
        case Accessory.Bow:
            <path d="M130,54 L108,40 L110,68 Z" fill="@L.AccessoryColor" />
            <path d="M130,54 L152,40 L150,68 Z" fill="@L.AccessoryColor" />
            <circle cx="130" cy="54" r="6" fill="@L.AccessoryColor" stroke="#00000022" />
            break;
        case Accessory.Antenna:
            <line x1="122" y1="46" x2="138" y2="14" stroke="@L.AccessoryColor" stroke-width="3" />
            <circle cx="139" cy="12" r="6" fill="@L.AccessoryColor" filter="url(#@Id("glow"))" class="blink" />
            break;
        case Accessory.Headphones:
            <path d="M44,104 C40,26 160,26 156,104" stroke="@L.AccessoryColor" stroke-width="8" fill="none" />
            <rect x="34" y="92" width="18" height="36" rx="8" fill="@L.AccessoryColor" />
            <rect x="148" y="92" width="18" height="36" rx="8" fill="@L.AccessoryColor" />
            break;
        case Accessory.Headband:
            <path d="M56,64 Q100,30 144,64" stroke="#ffffff" stroke-width="12" fill="none" stroke-linecap="round" />
            <path d="M56,64 Q100,30 144,64" stroke="@L.OutfitColor" stroke-width="3" stroke-dasharray="5 5" fill="none" />
            break;
        case Accessory.StarClip:
            <polygon points="@Star(136, 62, 11, 5)" fill="@L.AccessoryColor" stroke="#00000022" />
            <polygon points="@Star(150, 80, 6, 2.6)" fill="@L.AccessoryColor" opacity="0.9" />
            break;
        case Accessory.Crown:
            <polygon points="70,50 74,18 88,36 100,10 112,36 126,18 130,50" fill="@L.AccessoryColor" stroke="#a67c00" stroke-width="2" />
            <circle cx="100" cy="38" r="4" fill="#e53935" />
            <circle cx="84" cy="44" r="3" fill="#1e88e5" />
            <circle cx="116" cy="44" r="3" fill="#43a047" />
            break;
    }

    @* ---------- Mood effects ---------- *@
    @if (Mood == Mood.Shocked)
    {
        <path d="M160,80 Q168,94 160,100 Q152,94 160,80 Z" fill="#7cc8ff" opacity="0.9" />
        <path d="M60,66 L66,74 M70,62 L74,72 M80,60 L82,70" stroke="#5a7cff" stroke-width="2.5" stroke-linecap="round" />
    }
    @if (Mood is Mood.Happy or Mood.Love)
    {
        <polygon class="sparkle" points="@Star(28, 40, 8, 2.5, 4)" fill="#fff6a8" />
        <polygon class="sparkle s2" points="@Star(176, 34, 6, 2, 4)" fill="#fff6a8" />
        <polygon class="sparkle s3" points="@Star(182, 176, 7, 2, 4)" fill="#ffffff" />
    }
    @if (Mood == Mood.Thinking)
    {
        @* Razor reserves <text>, so emit the SVG text element as raw markup. *@
        @((MarkupString)$"<text x=\"160\" y=\"56\" font-size=\"28\" font-weight=\"bold\" fill=\"{L.OutfitAccent}\">?</text>")
    }
</svg>

@code {
    private static int _instance;
    private readonly int _id = Interlocked.Increment(ref _instance);

    [Parameter, EditorRequired] public Skin Skin { get; set; } = SkinCatalog.Default;
    [Parameter] public Mood Mood { get; set; } = Mood.Idle;
    [Parameter] public bool Small { get; set; }

    private MascotLook L => Skin.Look;

    private string Id(string name) => $"m{_id}-{name}";

    private static string Star(double cx, double cy, double outer, double inner, int points = 5)
    {
        var parts = new List<string>(points * 2);
        for (var i = 0; i < points * 2; i++)
        {
            var r = i % 2 == 0 ? outer : inner;
            var a = Math.PI / points * i - Math.PI / 2;
            parts.Add(string.Create(CultureInfo.InvariantCulture, $"{cx + r * Math.Cos(a):0.#},{cy + r * Math.Sin(a):0.#}"));
        }
        return string.Join(' ', parts);
    }
}
