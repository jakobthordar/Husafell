<FormField Label="@Label" IsRequired="@IsRequired" HelpText="@HelpText" ErrorMessage="@ErrorMessage">
    <InputFile class="@GetInputClass()" 
               OnChange="HandleFileSelected"
               accept="@Accept"
               multiple="@Multiple"
               disabled="@Disabled" />
    
    @if (SelectedFiles.Any())
    {
        <div class="mt-2">
            <small class="text-muted">Selected files:</small>
            <ul class="list-unstyled mb-0">
                @foreach (var file in SelectedFiles)
                {
                    <li class="small">@file.Name (@FormatFileSize(file.Size))</li>
                }
            </ul>
        </div>
    }
</FormField>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Accept { get; set; }

    [Parameter]
    public bool Multiple { get; set; }

    [Parameter]
    public bool IsRequired { get; set; }

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<IBrowserFile>> OnFilesSelected { get; set; }

    private List<IBrowserFile> SelectedFiles { get; set; } = new();

    private bool HasError => !string.IsNullOrEmpty(ErrorMessage);

    private string GetInputClass()
    {
        return HasError ? "form-control is-invalid" : "form-control";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFiles = e.GetMultipleFiles(Multiple ? 10 : 1).ToList();
        await OnFilesSelected.InvokeAsync(SelectedFiles);
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
